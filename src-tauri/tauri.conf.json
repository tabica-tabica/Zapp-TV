{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zapp TV",
  "version": "1.1.1",
  "identifier": "com.tabica-tabica.zapptv",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zapp TV",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
